{
  "manifest_version": 3,
  "name": "cdpclick Normal Chrome Bridge",
  "version": "1.0.0",
  "description": "Connects trusted local tools to the current Chrome profile through chrome.debugger.",
  "key": "",
  "permissions": [
    "debugger",
    "nativeMessaging",
    "tabs"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "cdpclick Normal Chrome Bridge"
  }
}
